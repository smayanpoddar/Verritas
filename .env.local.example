# Copy this file to .env.local and fill in your real key.
# .env.local is gitignored — it will never be committed.

# Get a free API key at https://resend.com (no credit card needed).
# Free tier: 100 emails/day, 3,000/month — plenty for a contact form.
# Without this set, the dealer form on the site falls back to opening
# the visitor's own email app instead of sending automatically.
RESEND_API_KEY=
